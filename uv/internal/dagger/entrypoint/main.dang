        .withField("Path", typeDef.withKind(TypeDefKind.STRING_KIND), description: "Project root, relative to the workspace root", sourceMap: sourceMap("plan.go", 151, 2))
        .withField("Source", typeDef.withObject("Directory"), description: "The project's files and those of its local dependencies", sourceMap: sourceMap("plan.go", 153, 2)),
      typeDef.withObject("UvSyncPlan", description: "Resolved build configuration for a uv workspace sync.", sourceMap: sourceMap("plan.go", 222, 6))
        .withField("WsDir", typeDef.withObject("Directory"), description: "The workspace root's manifests: uv.lock, uv.toml and pyproject.toml files", sourceMap: sourceMap("plan.go", 224, 2))
        .withField("SourceDir", typeDef.withObject("Directory"), description: "Every member's files; read only for files outside the needed packages, e.g. symlink targets", sourceMap: sourceMap("plan.go", 226, 2))
        .withField("WorkspacePath", typeDef.withKind(TypeDefKind.STRING_KIND), description: "Workspace path within the source directory", sourceMap: sourceMap("plan.go", 228, 2))
        .withField("AllLocal", typeDef.withListOf(typeDef.withObject("LocalPackage")), description: "Every local package in the workspace (sorted by name)", sourceMap: sourceMap("plan.go", 230, 2))
        .withField("NeededLocal", typeDef.withListOf(typeDef.withObject("LocalPackage")), description: "Local packages the target transitively depends on (sorted by name)", sourceMap: sourceMap("plan.go", 232, 2))
        .withField("FlatPackages", typeDef.withListOf(typeDef.withKind(TypeDefKind.STRING_KIND)), description: "Virtual/deps-only packages: pyproject scaffolded, source skipped", sourceMap: sourceMap("plan.go", 234, 2))
        .withField("UvSyncArgs", typeDef.withListOf(typeDef.withKind(TypeDefKind.STRING_KIND)), description: "Precomputed uv sync argv", sourceMap: sourceMap("plan.go", 236, 2))
        .withField("NoEditable", typeDef.withKind(TypeDefKind.BOOLEAN_KIND), description: "Local packages installed non-editable (source baked into site-packages, not path-linked)", sourceMap: sourceMap("plan.go", 238, 2))
        .withField("Handlers", typeDef.withListOf(typeDef.withInterface("BuildBackendHandler")), description: "Build backend handlers, whose hooks run around the local packages' build", sourceMap: sourceMap("plan.go", 240, 2)),
      typeDef.withObject("LocalPackage", description: "A local (editable/directory/virtual) package in a uv workspace.\n\n``pyproject_contents`` is captured while resolving the plan so scaffold\nlayers depend on package metadata, not on the whole source directory.", sourceMap: sourceMap("plan.go", 163, 2))
        .withField("Name", typeDef.withKind(TypeDefKind.STRING_KIND), description: "Package name", sourceMap: sourceMap("plan.go", 165, 3))
