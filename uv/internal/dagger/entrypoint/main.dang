        .withFunction(
          function("Teardown", typeDef.withObject("Container"))
            .withDescription("Remove what `setup` added that shouldn't stay in the final container, e.g. variables or secrets.\n\nRuns right after that `uv sync`. Return `container` unchanged when nothing is needed.")
            .withSourceMap(sourceMap("handler.go", 54, 10))
            .withArg("container", typeDef.withObject("Container"), description: "An OCI-compatible container, also known as a Docker container.", sourceMap: sourceMap("handler.go", 56, 3))
