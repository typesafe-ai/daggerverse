        .withField("Flat", typeDef.withKind(TypeDefKind.BOOLEAN_KIND), description: "Flat layout (module at package root) vs src layout (module under src/)", sourceMap: sourceMap("plan.go", 171, 3))
        .withField("PyprojectContents", typeDef.withKind(TypeDefKind.STRING_KIND), description: "Already-read package metadata used when creating a dependency scaffold", sourceMap: sourceMap("plan.go", 173, 3))
        .withField("Source", typeDef.withObject("Directory"), description: "The package's files and those of its local dependencies, at workspace-root-relative paths", sourceMap: sourceMap("plan.go", 175, 3))
        .withField("Layout", typeDef.withObject("BuildBackendLayout"), description: "Layout resolved from a build backend handler, replacing the built-in backend settings", sourceMap: sourceMap("plan.go", 177, 3))
        .withField("Handler", typeDef.withKind(TypeDefKind.INTEGER_KIND).withOptional(true), description: "Index of the plan's `handlers` entry for this package's backend; null for built-in support", sourceMap: sourceMap("plan.go", 179, 3)),
      typeDef.withObject("BuildBackendLayout", description: "A package layout resolved from a `BuildBackendHandler`.", sourceMap: sourceMap("handler.go", 82, 6))
        .withField("ModuleName", typeDef.withKind(TypeDefKind.STRING_KIND).withOptional(true), description: "Import name for the generic layout, if declared", sourceMap: sourceMap("handler.go", 84, 2))
        .withField("ModulePaths", typeDef.withListOf(typeDef.withKind(TypeDefKind.STRING_KIND)), description: "Import directories (or `.py` modules) to scaffold", sourceMap: sourceMap("handler.go", 86, 2))
        .withField("SourcePaths", typeDef.withListOf(typeDef.withKind(TypeDefKind.STRING_KIND)), description: "Directories (or files) to copy", sourceMap: sourceMap("handler.go", 88, 2))
        .withField("BuildInputs", typeDef.withListOf(typeDef.withKind(TypeDefKind.STRING_KIND)), description: "Files (or globs) the backend reads while building", sourceMap: sourceMap("handler.go", 90, 2)),
      typeDef.withInterface("BuildBackendHandler", description: "Tells the module how a build backend builds the packages that use it.\n\nEvery function except `build_backend`, `setup` and `teardown` receives the\npackage's `pyproject.toml` contents and its distribution name.\nReturning an empty `module_name` falls back to the generic layout: the\nmodule named after the distribution, under `src/` or at the package root.\nEmpty `module_paths` or `source_paths` fall back the same way only where the\nmodule's built-in support for the package's backend would.", sourceMap: sourceMap("handler.go", 31, 6))
        .withFunction(
          function("BuildBackend", typeDef.withKind(TypeDefKind.STRING_KIND))
            .withDescription("The `[build-system].build-backend` value this handler handles, e.g. `setuptools.build_meta`.")
            .withSourceMap(sourceMap("handler.go", 34, 14))
        )
        .withFunction(
          function("BuildInputs", typeDef.withListOf(typeDef.withKind(TypeDefKind.STRING_KIND)))
            .withDescription("Files (or globs) the backend reads while building: package-relative, or workspace-root-relative with `/`.")
            .withSourceMap(sourceMap("handler.go", 42, 13))
            .withArg("pyproject", typeDef.withKind(TypeDefKind.STRING_KIND), sourceMap: sourceMap("handler.go", 42, 35))
            .withArg("name", typeDef.withKind(TypeDefKind.STRING_KIND), sourceMap: sourceMap("handler.go", 42, 53))
        )
        .withFunction(
          function("ModuleName", typeDef.withKind(TypeDefKind.STRING_KIND))
            .withDescription("The import name for the generic layout, dotted for a module inside namespace packages.")
            .withSourceMap(sourceMap("handler.go", 36, 12))
            .withArg("pyproject", typeDef.withKind(TypeDefKind.STRING_KIND), sourceMap: sourceMap("handler.go", 36, 34))
            .withArg("name", typeDef.withKind(TypeDefKind.STRING_KIND), sourceMap: sourceMap("handler.go", 36, 52))
        )
        .withFunction(
          function("ModulePaths", typeDef.withListOf(typeDef.withKind(TypeDefKind.STRING_KIND)))
            .withDescription("Package-relative import directories (or `.py` modules) to scaffold.")
            .withSourceMap(sourceMap("handler.go", 38, 13))
            .withArg("pyproject", typeDef.withKind(TypeDefKind.STRING_KIND), sourceMap: sourceMap("handler.go", 38, 35))
            .withArg("name", typeDef.withKind(TypeDefKind.STRING_KIND), sourceMap: sourceMap("handler.go", 38, 53))
        )
        .withFunction(
          function("Setup", typeDef.withObject("Container"))
            .withDescription("Prepare the container before the local packages build, e.g. mount caches, set variables or secrets.\n\nRuns once per build, before the `uv sync` that builds every local package\nthis handler handles. Return `container` unchanged when nothing is needed.")
            .withSourceMap(sourceMap("handler.go", 47, 7))
            .withArg("container", typeDef.withObject("Container"), description: "An OCI-compatible container, also known as a Docker container.", sourceMap: sourceMap("handler.go", 49, 3))
        )
        .withFunction(
          function("SourcePaths", typeDef.withListOf(typeDef.withKind(TypeDefKind.STRING_KIND)))
            .withDescription("Package-relative directories (or files) to copy as the package's source.")
