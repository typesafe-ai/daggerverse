        .withField("PublishUrl", typeDef.withKind(TypeDefKind.STRING_KIND).withOptional(true), description: "URL to use when publishing packages to this index (defaults to `url` if unset).", sourceMap: sourceMap("index.go", 18, 2))
        .withField("Default", typeDef.withKind(TypeDefKind.BOOLEAN_KIND), description: "When true, this index replaces PyPI as the default index.", sourceMap: sourceMap("index.go", 20, 2))
        .withField("Explicit", typeDef.withKind(TypeDefKind.BOOLEAN_KIND), description: "When true, packages are only installed from this index if explicitly pinned to it.", sourceMap: sourceMap("index.go", 22, 2))
        .withField("Authenticate", typeDef.withKind(TypeDefKind.STRING_KIND).withOptional(true), description: "Credential handling: 'always', 'never', or null (try unauthenticated first, then authenticate).", sourceMap: sourceMap("index.go", 24, 2))
        .withField("Format", typeDef.withKind(TypeDefKind.STRING_KIND).withOptional(true), description: "Index format: 'flat' for flat directories/HTML lists, null for standard PEP 503 registries.", sourceMap: sourceMap("index.go", 26, 2)),
      typeDef.withObject("UvPackageSource", description: "A single member package within a uv workspace.\n\nCarries the workspace's manifests, the workspace root path, and the\nmember's own path so it can read both workspace-level and package-level\nindex configuration.", sourceMap: sourceMap("package.go", 17, 6))
        .withFunction(
          function("Indices", typeDef.withListOf(typeDef.withObject("UvIndex")))
            .withDescription("The package indices configured in this member's `pyproject.toml`.\n\nReads `[[tool.uv.index]]` from the member's own `pyproject.toml`.\nWhen `include_from_workspace` is set, also reads workspace-level\nindices and merges them (package-level entries win on name collision).")
            .withSourceMap(sourceMap("package.go", 46, 1))
            .withArg("includeFromWorkspace", typeDef.withKind(TypeDefKind.BOOLEAN_KIND), description: "Merge indices from the workspace root's configuration. When True, workspace-level indices are included alongside the package's own indices (deduplicated by name, package wins).", defaultValue: ("false" :: Dagger.JSON!), sourceMap: sourceMap("package.go", 50, 2))
        )
        .withField("Manifests", typeDef.withObject("Directory"), description: "The workspace's manifests: uv.lock, uv.toml and pyproject.toml files.", sourceMap: sourceMap("package.go", 19, 2))
        .withField("WorkspacePath", typeDef.withKind(TypeDefKind.STRING_KIND), description: "Workspace root path within the manifests (`.` for a root workspace).", sourceMap: sourceMap("package.go", 21, 2))
        .withField("PackagePath", typeDef.withKind(TypeDefKind.STRING_KIND), description: "Package path relative to the workspace root.", sourceMap: sourceMap("package.go", 23, 2)),
      typeDef.withObject("UvVenv", description: "A relocatable uv virtual environment bundled with the uv-managed Python it needs.\n\nA venv never contains the standard library: `.venv/bin/python` resolves to\na base interpreter whose `lib/` provides it. This pairs the venv with that\ninterpreter so the two can be dropped into a fresh container (one without any\nPython of its own) and run without uv.\n\nOnly valid for a venv created with `build(venv_relocatable=True)` against a\n*uv-managed* (standalone) Python: uv's standalone Pythons are themselves\nrelocatable, and a relocatable venv keeps working when its directory is moved.\nThe venv may be mounted at any path, but the Python must be remounted at\n`python_path` (the absolute location its `pyvenv.cfg` records).\n\nThe bundled Python is the python-build-standalone variant uv selected for the\nbase image's platform/libc (set by `base_container` at build time), so the\ntarget container must match it: a Debian (glibc) base exports to glibc targets,\nan Alpine (musl) base to musl/alpine targets.", sourceMap: sourceMap("venv.go", 31, 6))
        .withFunction(
          function("Into", typeDef.withObject("Container"))
            .withDescription("Mount the venv (at `path`) and its Python (at `python_path`) into `container`.\n\nWith `set_env_vars`, exports `VIRTUAL_ENV` and prepends the venv's `bin/`\nto `PATH` so `python`/console scripts resolve without activation;\notherwise the venv is just mounted (run it via `<path>/bin/python`).")
            .withSourceMap(sourceMap("venv.go", 93, 1))
            .withArg("container", typeDef.withObject("Container"), description: "Container to add the venv and its Python to.", sourceMap: sourceMap("venv.go", 96, 2))
            .withArg("path", typeDef.withKind(TypeDefKind.STRING_KIND), description: "Where to mount the venv; relative paths resolve against the container's workdir. Defaults to `.venv`.", defaultValue: ("\".venv\"" :: Dagger.JSON!), sourceMap: sourceMap("venv.go", 99, 2))
            .withArg("setEnvVars", typeDef.withKind(TypeDefKind.BOOLEAN_KIND), description: "Also set the standard activation env vars (`VIRTUAL_ENV` and a `PATH` with the venv's `bin/` first).", defaultValue: ("false" :: Dagger.JSON!), sourceMap: sourceMap("venv.go", 102, 2))
        )
        .withField("Venv", typeDef.withObject("Directory"), description: "The relocatable `.venv` directory.", sourceMap: sourceMap("venv.go", 33, 2))
        .withField("Python", typeDef.withObject("Directory"), description: "uv's managed-Python store (the interpreter the venv links against, plus uv's version symlinks).", sourceMap: sourceMap("venv.go", 35, 2))
        .withField("PythonPath", typeDef.withKind(TypeDefKind.STRING_KIND), description: "Absolute path the Python store must be mounted at for the venv to resolve its interpreter.", sourceMap: sourceMap("venv.go", 37, 2)),
