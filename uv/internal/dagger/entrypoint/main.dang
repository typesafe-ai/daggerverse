      typeDef.withObject("UvWorkspaceBuild", description: "An in-progress workspace build: a container plus its resolved sync plan.\n\nDrives the install pipeline: `with_remote_dependencies` to install remote\ndeps, `with_workspace_files` to scaffold local packages, then\n`with_local_dependencies` to install them.", sourceMap: sourceMap("build.go", 31, 6))
        .withFunction(
          function("CopyVenv", typeDef.withObject("Container"))
            .withDescription("Copy this build's venv (and the uv-managed Python it needs) into `container`.\n\nConvenience over `venv().into(...)`: mounts the relocatable venv at `path`\nand its Python at the absolute path the venv expects, yielding a container\nthat can run the environment without uv. Same constraints as `venv`.")
            .withSourceMap(sourceMap("build.go", 210, 1))
            .withArg("container", typeDef.withObject("Container"), description: "Container to copy the venv and its Python into.", sourceMap: sourceMap("build.go", 213, 2))
            .withArg("path", typeDef.withKind(TypeDefKind.STRING_KIND), description: "Where to mount the venv; relative paths resolve against the container's workdir. Defaults to `.venv`.", defaultValue: ("\".venv\"" :: Dagger.JSON!), sourceMap: sourceMap("build.go", 216, 2))
            .withArg("setEnvVars", typeDef.withKind(TypeDefKind.BOOLEAN_KIND), description: "Also set the standard activation env vars (`VIRTUAL_ENV` and a `PATH` with the venv's `bin/` first).", defaultValue: ("false" :: Dagger.JSON!), sourceMap: sourceMap("build.go", 219, 2))
        )
        .withFunction(
          function("Venv", typeDef.withObject("UvVenv"))
            .withDescription("Export this build's virtual environment together with the Python it needs.\n\nBundles the venv and the exact interpreter it links against into a\n`UvVenv` (see `UvVenv.create`). Call after the venv is populated (e.g.\nafter `with_remote_dependencies`/`with_local_dependencies`). Requires a\nrelocatable venv built against a uv-managed Python; raises otherwise.")
            .withSourceMap(sourceMap("build.go", 197, 1))
        )
        .withFunction(
          function("WithAllWorkspaceMembers", typeDef.withObject("UvWorkspaceBuild"))
            .withDescription("Like with_workspace_files but scaffolds every local package, not just transitive deps.")
            .withSourceMap(sourceMap("build.go", 341, 1))
        )
        .withFunction(
          function("WithCachePrune", typeDef.withObject("UvWorkspaceBuild"))
            .withDescription("Prune the uv cache with `uv cache prune --ci`, gated on cache size.\n\nMeasures the cache dir (`uv cache dir`) and only prunes when it exceeds `max_cache_size`\nGiB, so most builds skip the prune (and never take the cache lock). Because\n`uv cache prune --ci` keeps only compiled wheels (nearly a full clean), one\nprune resets the footprint. `lock_timeout` sets `UV_LOCK_TIMEOUT` for the\nprune so concurrent builds sharing the cache volume wait instead of erroring.\nSet `max_cache_size=0` to prune on every build.\n\nThe size check and conditional prune run in a single exec so the live cache\nvolume is measured each time this step actually runs, rather than reading a\nstale, separately-cached size.\n\nLearn more about the reasoning in [uv docs](https://docs.astral.sh/uv/concepts/cache/#caching-in-continuous-integration).")
            .withSourceMap(sourceMap("build.go", 123, 1))
            .withArg("maxCacheSize", typeDef.withKind(TypeDefKind.INTEGER_KIND), description: "Prune the uv cache only once it grows past this many GiB.", defaultValue: ("100" :: Dagger.JSON!), sourceMap: sourceMap("build.go", 127, 2))
            .withArg("lockTimeout", typeDef.withKind(TypeDefKind.INTEGER_KIND), description: "Seconds uv waits to acquire the cache file lock (`UV_LOCK_TIMEOUT`) while pruning the cache.", defaultValue: ("600" :: Dagger.JSON!), sourceMap: sourceMap("build.go", 130, 2))
        )
        .withFunction(
          function("WithContainer", typeDef.withObject("UvWorkspaceBuild"))
            .withDescription("Return a new UvWorkspaceBuild with a different container but the same plan.")
            .withSourceMap(sourceMap("build.go", 354, 1))
            .withArg("container", typeDef.withObject("Container"), description: "Replacement container (e.g. after installing non-Python packages)", sourceMap: sourceMap("build.go", 356, 2))
        )
        .withFunction(
          function("WithLocalDependencies", typeDef.withObject("Container"))
            .withDescription("Install the scaffolded local packages, copying their real source at the right time.\n\nFor **editable** installs (the default), run `uv sync` against the package\nstubs from `with_workspace_files`, then copy real source over the stubs last.\nEditable installs are path links, so the source goes live without a re-sync\nand source-only changes don't invalidate the cached install layer.\n\nFor **non-editable** installs (`no_editable=True`), `uv sync` builds a wheel\nfrom whatever source is present and bakes it into `site-packages`, so the real\nsource must be copied in *before* the sync: there are no path links for a\ncopy-last to make live, and syncing against the stubs would bake empty modules.")
            .withSourceMap(sourceMap("build.go", 506, 1))
        )
        .withFunction(
          function("WithPythonInstall", typeDef.withObject("UvWorkspaceBuild"))
            .withDescription("Install a managed Python via `uv python install`.\n\nUseful on a bare base with no system Python; pass the version the\nworkspace's `requires-python` resolves to.")
            .withSourceMap(sourceMap("build.go", 170, 1))
            .withArg("version", typeDef.withKind(TypeDefKind.STRING_KIND), description: "Python version to install via `uv python install` (e.g. `3.12`, `3.13.7`).", sourceMap: sourceMap("build.go", 173, 2))
        )
        .withFunction(
          function("WithPythonPin", typeDef.withObject("UvWorkspaceBuild"))
            .withDescription("Pin the project's Python with `uv python pin` (writes `.python-version`).\n\nMakes subsequent `uv sync` select this exact version.")
            .withSourceMap(sourceMap("build.go", 182, 1))
            .withArg("version", typeDef.withKind(TypeDefKind.STRING_KIND), description: "Python version to pin via `uv python pin` (writes a `.python-version` file).", sourceMap: sourceMap("build.go", 185, 2))
        )
        .withFunction(
          function("WithRemoteDependencies", typeDef.withObject("UvWorkspaceBuild"))
            .withDescription("Install remote (non-local) dependencies via `uv sync --no-install-local`.\n\nWhen `prune_cache` is set (the default), the\ninstall is followed by a size-gated `uv cache prune --ci` (see\n`with_cache_prune`): the cache is pruned only once it exceeds\n`max_cache_size` GiB, and `lock_timeout` bounds how long that prune waits\nfor the cache lock.")
            .withSourceMap(sourceMap("build.go", 86, 1))
            .withArg("pruneCache", typeDef.withKind(TypeDefKind.BOOLEAN_KIND), description: "Whether to run `uv cache prune --ci` after installing remote dependencies. Learn more about the reasoning in [uv docs](https://docs.astral.sh/uv/concepts/cache/#caching-in-continuous-integration).", defaultValue: ("true" :: Dagger.JSON!), sourceMap: sourceMap("build.go", 90, 2))
            .withArg("maxCacheSize", typeDef.withKind(TypeDefKind.INTEGER_KIND), description: "Prune the uv cache only once it grows past this many GiB.", defaultValue: ("100" :: Dagger.JSON!), sourceMap: sourceMap("build.go", 93, 2))
            .withArg("lockTimeout", typeDef.withKind(TypeDefKind.INTEGER_KIND), description: "Seconds uv waits to acquire the cache file lock (`UV_LOCK_TIMEOUT`) while pruning the cache.", defaultValue: ("600" :: Dagger.JSON!), sourceMap: sourceMap("build.go", 96, 2))
        )
        .withFunction(
          function("WithUv", typeDef.withObject("UvWorkspaceBuild"))
            .withDescription("Copy the uv binary into the build container.\n\nUseful when using a custom `base_container` that doesn't ship uv.\nCopies the static binary from the official distroless image to `/uv/uv`\nand prepends `/uv` to `$PATH`.")
            .withSourceMap(sourceMap("build.go", 56, 1))
            .withArg("version", typeDef.withKind(TypeDefKind.STRING_KIND).withOptional(true), description: "uv version to install. Defaults to the version detected from the workspace.", sourceMap: sourceMap("build.go", 60, 2))
        )
        .withFunction(
          function("WithWorkspaceFiles", typeDef.withObject("UvWorkspaceBuild"))
            .withDescription("Scaffold needed local package stubs (pyproject.toml + empty src/) into the container.")
            .withSourceMap(sourceMap("build.go", 328, 1))
