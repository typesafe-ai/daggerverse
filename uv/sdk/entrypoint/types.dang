            .withArg("group", typeDef.withOptional(true).withListOf(typeDef.withKind(TypeDefKind.STRING_KIND)).withOptional(true), defaultValue: ("null" :: Dagger.JSON!))
            .withArg("all_extras", typeDef.withKind(TypeDefKind.BOOLEAN_KIND), description: "Install every extra; maps to `uv sync --all-extras`", defaultValue: ("false" :: Dagger.JSON!))
            .withArg("all_groups", typeDef.withKind(TypeDefKind.BOOLEAN_KIND), description: "Install every dependency group; maps to `uv sync --all-groups`", defaultValue: ("false" :: Dagger.JSON!))
            .withArg("all_packages", typeDef.withKind(TypeDefKind.BOOLEAN_KIND), description: "Install every workspace member; maps to `uv sync --all-packages`", defaultValue: ("false" :: Dagger.JSON!))
            .withArg("no_editable", typeDef.withKind(TypeDefKind.BOOLEAN_KIND), description: "Install local/workspace packages non-editable (`uv sync --no-editable`), baking their source into site-packages instead of linking it. Makes the resulting venv self-contained, so it can be exported/copied (e.g. via `copy_venv`) without also carrying the workspace source.", defaultValue: ("false" :: Dagger.JSON!))
            .withArg("prune_cache", typeDef.withKind(TypeDefKind.BOOLEAN_KIND), description: "Whether to run `uv cache prune --ci` after installing remote dependencies. Learn more about the reasoning in [uv docs](https://docs.astral.sh/uv/concepts/cache/#caching-in-continuous-integration).", defaultValue: ("true" :: Dagger.JSON!))
            .withArg("max_cache_size", typeDef.withKind(TypeDefKind.INTEGER_KIND), description: "Prune the uv cache only once it grows past this many GiB.", defaultValue: ("100" :: Dagger.JSON!))
            .withArg("lock_timeout", typeDef.withKind(TypeDefKind.INTEGER_KIND), description: "Seconds uv waits to acquire the cache file lock (`UV_LOCK_TIMEOUT`) while pruning the cache.", defaultValue: ("600" :: Dagger.JSON!))
            .withArg("auto_install_uv", typeDef.withKind(TypeDefKind.BOOLEAN_KIND), description: "Automatically install the uv binary if it is not already on $PATH. Set to False if your base_container already ships uv.", defaultValue: ("true" :: Dagger.JSON!))
        ),
      typeDef.withObject("UvWorkspaces", description: "Every uv workspace in the source tree (one per uv.lock), keyed by its path.\n\n`audit` runs once per selected workspace, so each workspace is its own check\nthat can be selected or skipped on its own.")
        .withCollection
        .withField("paths", typeDef.withListOf(typeDef.withKind(TypeDefKind.STRING_KIND)), description: "uv workspace root paths (holding uv.lock), relative to the workspace root. `.` for the root.")
        .withField("source", typeDef.withObject("Directory"), description: "Source tree containing the workspaces.")
        .withCollectionKeys("paths")
        .withCollectionGet("workspace")
        .withFunction(
          function("workspace", typeDef.withObject("UvWorkspaceSource"))
            .withDescription("The uv workspace rooted at `path`.")
            .withArg("path", typeDef.withKind(TypeDefKind.STRING_KIND), description: "Path to the uv workspace root (holding uv.lock and pyproject.toml), relative to the workspace root.")
        ),
      typeDef.withObject("Uv", description: "Entrypoint for the `uv` module.\n\nHands out `UvWorkspaceSource` objects — one per workspace — which expose additional functionality.\nUse `workspace` to grab a single workspace by path or `workspaces` to get them all.\n\nLearn more in the [docs](https://daggerverse.docs.typesafe.ai/uv/).")
        .withField("source", typeDef.withObject("Directory"), description: "Source tree: the Dagger workspace, less caches, virtualenvs and gitignored files.")
        .withField("workspace_paths", typeDef.withListOf(typeDef.withKind(TypeDefKind.STRING_KIND)), description: "Paths of the uv workspaces found in the source tree, relative to its root.")
        .withFunction(
          function("workspace", typeDef.withObject("UvWorkspaceSource"))
            .withDescription("A single uv workspace at `path`, relative to the workspace root.\n\nThe returned `UvWorkspaceSource` can `audit` its locked dependencies or\n`build` a minimal container for a package.")
            .withArg("path", typeDef.withKind(TypeDefKind.STRING_KIND), description: "Path to the uv workspace root (holding uv.lock and pyproject.toml), relative to the workspace root.")
        )
        .withFunction(
          function("workspaces", typeDef.withObject("UvWorkspaces"))
            .withDescription("Every uv workspace in the source tree (one per uv.lock), less those matching `exclude`.")
        )
        .withConstructor(
          function("", typeDef.withObject("Uv"))
            .withArg("ws", typeDef.withObject("Workspace"), description: "A Dagger workspace detected from the current working directory or\nconstructed from a Directory.")
            .withArg("exclude", typeDef.withOptional(true).withListOf(typeDef.withKind(TypeDefKind.STRING_KIND)).withOptional(true), description: "Glob patterns of workspace paths to leave out of workspaces, e.g. **/tests/_packages/**.", defaultValue: ("null" :: Dagger.JSON!))
        ),
    ]
  }
}
