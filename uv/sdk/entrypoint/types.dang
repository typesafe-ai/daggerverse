      typeDef.withObject("LocalPackage", description: "A local (editable/directory/virtual) package in a uv workspace.\n\n``pyproject_contents`` is captured while resolving the plan so scaffold\nlayers depend on package metadata, not on the whole source directory.")
        .withField("name", typeDef.withKind(TypeDefKind.STRING_KIND), description: "Package name")
        .withField("path", typeDef.withKind(TypeDefKind.STRING_KIND), description: "Workspace-relative path")
